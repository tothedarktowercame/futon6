 ;; ---------------------------------------------------------------------------
 ;; Informal reading: the pilot as a sequence of methods.
 ;; ---------------------------------------------------------------------------
 :clean/seq [:freeze-panel-and-boundary   ;; e1
             :fix-interpretation          ;; e2
             :verify-instrument           ;; e3
             :measure-arms                ;; e4
             :adjudicate]                 ;; e5

 ;; ---------------------------------------------------------------------------
 ;; Formal reading: the pipeline as a typed composition.
 ;; ---------------------------------------------------------------------------
 :clean/boxes
 [{:id :e1 :method :freeze-panel-and-boundary
   :text "Freeze the panel binding and the isolation boundary. Panel: problem a95J01, base revision 51b6bc00, LB memory e-codexpilot-analytic-order-at-least-two-implies-local-noninjectivity, IN memory e-codexpilot-combine-Schwarz-rigidity-with-power-series-uniqueness — one structure, per PanelEntry, so no run can mix-and-match. Boundary: scripts/e2_ablation_dispatch.sh as the apmablate user, staged tree at the base revision, ephemeral per-run CODEX_HOME containing auth.json only, codex invocations policed for exec --ephemeral --ignore-user-config --ignore-rules."
   :produces :frozen-panel
   :binding {:kind :artifact :type :edn/panel}}

  {:id :e2 :method :fix-interpretation
   :text "Commit the total decision rule BEFORE any run. Every trace the pilot can emit — boundary refusal, instrument failure, incomplete arms, complete — maps to a named outcome. Effect-shaped readouts are hypothesis-generating only; the rule cannot promote them."
   :consumes [:frozen-panel] :produces :decision-rule
   :binding {:kind :artifact :type :edn/decision}}

  {:id :e3 :method :verify-instrument
   :text "Run control run 1 as the instrument gate: the isolation receipt must validate (all probes true, process-bound, hash present); the run must leave >=1 incremental commit per attempt in the staged tree; the canonicalized decision-sequence extractor must produce a stable hash from those commits on two extractions. No arm run is permitted until this discharges. This is sensor verification, not a scientific control — it lives here as a gate, not as an axis (see the slot note in slice5-confirmation)."
   :consumes [:decision-rule] :produces :instrument-verified
   :binding {:kind :artifact :type :edn/control-result}
   :hole {:kind :gate :discharge :instrument-check :satiety :canon
          :wanted "receipt validity + commit discipline + extractor stability, each shown on the actual first run rather than asserted"}}
   ;; :satiety :canon matches slice5's experiment instrument-hole convention.
   ;; SatietyGrade is a fixed {parse|payoff|canon|bundling|role} enum from the
   ;; fold/proof domain; :canon is the established grade for an experiment
   ;; instrument gate. (Renderer gap: a MISSING :satiety emits an invalid
   ;; `SatietyGrade.None` rather than refusing — same class as the levels gap.)

  {:id :e4 :method :measure-arms
   :text "Run the three arms: control (full corpus), lb-ablated (withhold the bridge memory), inc-ablated (withhold the ignored memory; predicted null). runs-per-cell fresh ephemeral sessions each; ablation applied as filter-at-dispatch (mechanism b), licensed by the star-forest assumption below, whose runtime assertion runs before EVERY dispatch. Manipulation check per run: the withheld id absent from the offered set, the non-withheld memories present."
   :consumes [:instrument-verified] :produces :run-records
   :binding {:kind :artifact :type :edn/run-records}}

  {:id :e5 :method :adjudicate
   :text "Validate every trace through DarkTower validate (all protocol errors at once, or the only type classify accepts); apply the pre-committed decision rule. Identity rates read against the control-control floor, per the slice5 finding: for a predicted null, an identity rate is direct evidence where a CI is a power argument."
   :consumes [:run-records] :produces :verdict
   :binding {:kind :artifact :type :edn/verdict}
   :discharges {:to :decision-rule}}]

 :clean/wires
 [{:from :e1 :to :e2 :carries :frozen-panel}
  {:from :e2 :to :e3 :carries :decision-rule}
  {:from :e3 :to :e4 :carries :instrument-verified}
  {:from :e4 :to :e5 :carries :run-records}]

 ;; ---------------------------------------------------------------------------
 ;; The experiment block.
 ;; ---------------------------------------------------------------------------
 :clean/experiment-design
 {:claim :comparative

  ;; An axis is an ablation dial; :score-varies? is the navigability gate.
  ;; Levels are [0 1] = [present withheld] — the ablation dial encoded as the
  ;; standard binary Axis (as slice5 does), NOT keyword levels: the renderer
  ;; emits :levels verbatim into Lean, so symbolic levels produce invalid Lean.
  ;; 0/1 for present/withheld is faithful for a binary ablation, not a launder.
  ;; The LB axis carries the four-path inertness evidence; the IN axis is a
  ;; SCIENTIFIC control (prediction about the system), so it is an axis with
  ;; :score-varies? false and :role :positive-control — the render routes it
  ;; to axisPredictedNonNavigable (ArmRole change, mathlib4 084930e).
  :axes
  [{:id :lb-bridge-memory :levels [0 1] :score-varies? true
    :justification "Four-path inertness precondition, per path: (1) in-tree — the memory-free run invoke-1785393010025-303-f9f19596 (2026-07-30T06:30Z, commit 51b6bc00) stopped at exactly the missing nonvanishing-derivative/local-degree bridge; (2) library — direct and paraphrase searches for the bridge vocabulary return zero hits in the problem tree and pinned Mathlib at 51b6bc00 (re-verified independently at review, panel-nomination-sweep-20260801.md); (3) model competence — the same run is a recorded memory-free failure by the production runner; (4) delivery — the memory was reviewed-attached before the closing dispatch (frozen graph export 2026-07-30T19:00:54Z) and two later receipts attribute use; closure at 016bf0fb followed. Withholding therefore plausibly changes rediscovery cost, attempts, and the decision sequence."}
   {:id :inc-ignored-memory :levels [0 1] :score-varies? false
    :role :positive-control
    ;; :record-as-finding, NOT :abandon-run — this is the disposition claude-4
    ;; built the option for. If the incidental arm MOVES (the "ignored" memory
    ;; turns out to change the trajectory), that is a FINDING about the
    ;; receipt-incidental label, not an instrument failure to abandon on. The
    ;; slice5 positive control abandons because its violation means a Lean-proved
    ;; theorem is false; ours is a prediction under test. Same slot, opposite
    ;; epistemic role — which is exactly why the field is required, not defaulted.
    :on-violation :record-as-finding
    :justification "e-codexpilot-combine-Schwarz-rigidity-with-power-series-uniqueness surfaced on historical a95J01 dispatches and was recorded IGNORED in the receipts — incidental BY RECEIPT, not by the P2 rubric (this memory postdates the P2 census; noted in adjudication-verdicts-provenance.md). Prediction: withholding it leaves the decision sequence at the control-control identity floor. Topically adjacent-but-ignored is the most informative predicted null: the runner saw it and did not use it."}]

  :arms
  [{:id :control    :neutral? false :ablates []
    :role :baseline
    :note "full corpus; repeated runs supply the identity-rate floor that makes the other two arms readable under runner nondeterminism"}
   {:id :lb-ablated :neutral? false :ablates [:lb-bridge-memory]}
   {:id :inc-ablated :neutral? false :ablates [:inc-ignored-memory]
    :role :positive-control}]

  :scenarios [:a95J01-at-51b6bc00]

  :environment
  {:account "apmablate"
   :wrapper "futon3c/scripts/e2_ablation_dispatch.sh"
   :staged-tree "a95J01 at 51b6bc00 (native git tree id checked against 51b6bc00^{tree} inside the boundary)"
   :runner "codex exec --ephemeral --ignore-user-config --ignore-rules (policed by the wrapper)"
   :codex-home "per-run ephemeral, auth.json only (H3g minimal-credential finding: config.toml is leak-bearing; a fresh session under an existing CODEX_HOME is not a fresh state boundary)"
   :probes [:home-read-denied :no-analysis-artifacts :operator-store-unreadable
            :source-repo-unreachable :no-future-commits :own-store-clean
            :checkout-base-revision]
   :note "probes execute INSIDE the runner's process boundary and the receipt is hashed there; any probe failure refuses at exit 78 before the runner starts (verified live 2026-08-02, receipt 4825c2cb...)"}

  ;; FORMAT NOTE (bend candidate for claude-4): these runs are NOT seedable —
  ;; the runner is a stochastic LLM session. The replication unit is a fresh
  ;; ephemeral session; run-to-run variation is MEASURED (the control arm's
  ;; identity floor) rather than controlled. Disjointness from the confirmation
  ;; is by PROBLEM, not by seed: the confirmation panel is cohort-manufactured
  ;; pairs, and its registration must exclude a95J01 (its holdout block is the
  ;; enforcement point, mirroring this one).
  ;; RESOLVED via claude-4's ReplicationPlan (ι:Type) extension (2026-08-02):
  ;; both bends are gone. Bend #1 (vacuous disjointness oath) — a :stage :pilot
  ;; generates NO disjointness obligation, so the oath is dropped, not sworn.
  ;; Bend #2 (hard-coded seed formulas) — :seedable? false is now first-class
  ;; and OWES a floor endpoint instead of formulas: :variation :measured +
  ;; :floor-endpoint. Disjointness lives at ι:=ProblemId, in the confirmation's
  ;; registration, not here. Nothing fabricated; the burden moved, per the
  ;; axisPredictedNonNavigable principle (swap a proof burden, never suppress).
  :seeds {:stage :pilot
          :predecessor nil
          :seedable? false
          :variation :measured
          :floor-endpoint :identity-floor
          :runs-per-cell 4
          :replication-unit "fresh ephemeral codex session per run (sessionId uniqueness is a ProtocolError check in the Lean: shared sessions cannot validate)"
          ;; :identity-floor is a :role :primary endpoint (control-vs-control
          ;; decision-sequence identity rate). It IS the reproducibility
          ;; substitute a non-seedable design owes: without it, "treatment inert"
          ;; and "runner noisy" are indistinguishable (the ant result).
          :disjoint-from-confirmation "by problem at ι:=ProblemId: confirmation panel ∩ #{a95J01} = ∅, enforced in the confirmation's own registration"}

  ;; Every endpoint declares its sensor and coverage (extension 1). The pilot's
  ;; PRIMARY endpoints are apparatus properties; effect readouts are secondary
  ;; and hypothesis-generating — that split IS the pilot label, structurally.
  :outcomes
  [{:id :isolation-valid :direction :required-true :role :primary
    :sensor {:field :receipt/probe-results
             :source "wrapper receipt, process-bound, per run"
             :coverage-precondition "a receipt exists for every run; all probes true; probe-result-hash present"
             :coverage-check {:status :met-by-construction
                              :check "the wrapper refuses (exit 78, no receipt) rather than running unisolated; verified live incl. sabotage path 2026-08-02"}}}
   {:id :ablation-delivered :direction :required-true :role :primary
