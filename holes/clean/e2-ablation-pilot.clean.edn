 :clean/copar [{:reading :informal   :is :clean/seq}
               {:reading :formal     :is [:clean/boxes :clean/wires]}
               {:reading :executable :is :clean/experiment-design
                :note "renders to the malli schema the dispatch harness validates before any run; an unregistered arm is a startup failure, not a review finding"}]

 :clean/shape {:macro :controlled-ablation
               :holes-at [:e3]
               :assumptions-at [:filter-equals-ship
                                :recall-regime-stable
                                :statement-integrity]
               :discharges-at [:e5]
               :note "e3 is a hole in the INSTRUMENT (sensor verification), not in the hypothesis; the scientific control is the :inc-ignored-memory axis, routed to axisPredictedNonNavigable by its role"}}
