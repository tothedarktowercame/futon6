             :coverage-check {:status :met-by-construction
                              :check "e3 gates on exactly this before any arm runs; the extractor is NEW — first live use is this pilot, which is why e3 exists"}}
    :note "control-vs-control identity rate. Under nondeterminism the floor IS the yardstick: the IN arm's claim is identity ~ floor, the LB arm's is identity << floor (slice5 finding, relativized)"}
   {:id :attempts-to-close :direction :informational :role :secondary
    :sensor {:field :trace/attempt-count
             :source "same canonicalized trace"
             :coverage-precondition "as :identity-floor"
             :coverage-check {:status :met-by-construction :check "same gate"}}
