;; CLean — R13 (policy adequacy / multi-step G(π)) decomposed into its sub-boxes, with the
;; discrimination box marked as built-but-inert (a :hole wanting a real EIG signal). The ◐→box-pointer:
;; this replaces "R13 is partial" with "R13 needs a real EIG signal from A4a (currently 0)."
;; clean_argcheck-valid; build-match-checkable.

{:clean/proof "R13-decomposition"
 :clean/title "R13: multi-step rollout + discrimination — which box is inert"
 :clean/source {:requirement "R13" :status "apparatus built, discrimination built-but-inert" :commit "32ecd21"}

 :clean/seq [:rollout-apparatus :multi-step-witness :discrimination :policy-adequacy]

 :clean/boxes
 [{:id :b1 :method :rollout-apparatus
   :text "futon2.aif.rollout: project-policy (G(π)=Σγ^t g(s_t) path accumulator), expand-policies/score-policies (prior-weighted branching over the shared meme.step/step kernel), best-rollout/greedy-one-step, select-policy (argmin G + WM-I4 abstain). Built v0.21."
   :produces :rollout-mechanism}
  {:id :b2 :method :multi-step-witness
   :text "The 2-step-beats-greedy witness: rollout depth-2 produces a lower G(π) than greedy one-step on the test corpus. The multi-step policy mechanism is genuine, not decorative."
   :consumes [:rollout-mechanism]
   :produces :multi-step-evidence}
  {:id :b3 :method :discrimination
   :text "The EIG leg that breaks the G-ties false-floor: − λ·EIG in the forward ranker. BUILT (3a EIG leg, commit 32ecd21) but INERT — the EIG signal is 0 on the demo corpus because no capability/* edges exist for the posterior-stddev to vary over. The tie-floor is broken structurally but no real signal flows through it yet."
   :consumes [:multi-step-evidence]
   :produces :discriminating-policy
   :hole {:kind :sorry :discharge :queryAnswer :satiety :payoff
          :wanted "real EIG signal from A4a (currently 0 on the demo corpus) — the discrimination apparatus is built but starved of the posterior-variance signal that would make ranks 2+ separate. Built-but-inert, not missing code."}}
  {:id :b4 :method :policy-adequacy
   :text "A multi-step policy that discriminates among candidates (not just beats greedy). Discharges the R13 want-signature when the EIG signal flows."
   :consumes [:discriminating-policy]
   :produces :adequate-multi-step-policy
   :discharges {:to :multi-step-policy-that-discriminates}}]

 :clean/wires
 [{:from :b1 :to :b2 :carries :rollout-mechanism}
  {:from :b2 :to :b3 :carries :multi-step-evidence}
  {:from :b3 :to :b4 :carries :discriminating-policy}]

 :clean/copar [{:reading :informal :is :clean/seq}
               {:reading :formal   :is [:clean/boxes :clean/wires]}]

 :clean/shape {:macro :multi-step-policy-with-eig-discrimination
               :holes-at [:b3]
               :discharges-at [:b4]
               :note "b1 (rollout-apparatus) ✓ and b2 (multi-step-witness) ✓ are BUILT. b3 (discrimination) is BUILT-BUT-INERT: the EIG leg is wired (32ecd21) but the signal is 0 on the demo corpus (no capability/* edges for posterior-stddev to vary over). Needs A4a to merge fire. One unbuilt box (built-but-inert, not missing code)."}}
