;; CLean — CT treatment of an EXPERIMENT rather than a proof.
;; Slice 5 confirmation run: does any AIF term in the ant forager carry a
;; measurable explore/exploit effect?
;;
;; This is the first experiment-shaped CLean. The vocabulary extension is
;; deliberate and minimal: the existing :clean/boxes + :clean/wires machinery
;; carries the experiment PIPELINE unchanged (a pipeline is a typed composition
;; like any other), and one new block :clean/experiment carries the parts a
;; proof does not have — arms, axes, seeds, stopping, interpretation.
;;
;; :clean/copar gains a THIRD reading. A proof pairs informal prose with a formal
;; diagram; an experiment additionally has an EXECUTABLE reading, and the whole
;; point of registering it is that all three derive from this one file:
;;
;;   informal   -> the prose design (M-aif-stack.md)
;;   formal     -> generated Lean Registration (render = gate)
;;   executable -> malli-validated harness config (validation = gate)
;;
;; Predecessor pilot: futon2/holes/labs/ants-faithfulness/slice5.md (2026-08-01).
;; That run is a PILOT and stays labelled so: its data were observed before a
;; ReplicationPlan and total DecisionRule existed, so a prospective registration
;; cannot honestly be attached to it. This registers its CONFIRMATION.

{:clean/experiment "slice5-confirmation"
 :clean/title  "Do any AIF terms in the ant forager carry a measurable explore/exploit effect?"
 :clean/source {:mission "futon2/holes/M-aif-stack.md"
                :pilot   "futon2/holes/labs/ants-faithfulness/slice5.md"
                :pilot-sha "a5caf04ad4d6a568d82c2cc9ee27ee3ae259962f0e2622e502dd54a070b003c0"}
 :clean/status :registered-not-run

 ;; ---------------------------------------------------------------------------
 ;; The informal reading: the experiment as a sequence of methods.
 ;; ---------------------------------------------------------------------------
 :clean/seq [:freeze-environment       ;; e1
             :fix-interpretation       ;; e2
             :verify-instrument        ;; e3
             :measure-treatments       ;; e4
             :adjudicate]              ;; e5

 ;; ---------------------------------------------------------------------------
 ;; The formal reading: the pipeline as a typed composition. Each :produces must
 ;; be inhabited by a real artifact — this is what build-match checks.
 ;; ---------------------------------------------------------------------------
 :clean/boxes
 [{:id :e1 :method :freeze-environment
   :text "Freeze the environment config and the seed generator before any arm runs. Copied verbatim from the pilot so the two are comparable; seeds disjoint from it so the confirmation is independent."
   :produces :frozen-design
   :binding {:kind :artifact :type :edn/config}}

  {:id :e2 :method :fix-interpretation
   :text "Commit the total decision rule BEFORE data exist. Every trace the run can emit — complete, incomplete, control-violated, mixed-significance — maps to a named outcome."
   :consumes [:frozen-design] :produces :decision-rule
   :binding {:kind :artifact :type :edn/decision}}

  {:id :e3 :method :verify-instrument
   :text "Run the positive control first. :no-canonical-ambiguity must be bit-identical to :aif-full on every seed, because the canonical ambiguity addend is common to all candidates and cancels under argmax. If it differs, the analysis behind this design is wrong and the run is abandoned, not interpreted."
   :consumes [:decision-rule] :produces :instrument-verified
   :binding {:kind :artifact :type :edn/control-result}
   :hole {:kind :gate :discharge :positive-control :satiety :canon
          :wanted "paired run records identical, not merely equal yields — equal yields can conceal changed behaviour"}}

  {:id :e4 :method :measure-treatments
   :text "Run the treatment arms against the frozen design. Report yield AND starvation; the pilot established that yield alone penalises exactly the survival-trading behaviour the risk term exists to produce."
   :consumes [:instrument-verified] :produces :contrasts
   :binding {:kind :artifact :type :edn/contrasts}}

  {:id :e5 :method :adjudicate
   :text "Apply the pre-committed decision rule. No estimand substitution: the disposition of each hypothesis is fixed by e2."
   :consumes [:contrasts] :produces :verdict
   :binding {:kind :artifact :type :edn/verdict}
   :discharges {:to :decision-rule}}]

 :clean/wires
 [{:from :e1 :to :e2 :carries :frozen-design}
  {:from :e2 :to :e3 :carries :decision-rule}
  {:from :e3 :to :e4 :carries :instrument-verified}
  {:from :e4 :to :e5 :carries :contrasts}]

 ;; ---------------------------------------------------------------------------
 ;; The experiment block — what a proof does not have.
 ;; ---------------------------------------------------------------------------
 :clean/experiment-design
 {:claim :comparative

  ;; An axis is an ablation dial. :score-varies? is the NAVIGABILITY GATE:
  ;; the render must refuse to build an arm whose only axis has it false,
  ;; because ablating a term that cannot change selection is not a treatment.
  ;; Every value here carries its justification, so a reader can reject the
  ;; premise rather than the conclusion.
  :axes
  [{:id :canonical-ambiguity :levels [0 1] :score-varies? false
    :role :positive-control
    :justification "computed from (:var mu), identical across candidate actions (policy.clj:612-624); a common addend cannot change an argmax. Proved in DarkTower/Slice5Preregistration.lean as ambiguity_ablation_preserves_selection."}
   {:id :directed-eig :levels [0 1] :score-varies? true
    :justification "food_belief.clj:101-149; action-dependent, so it can reorder candidates."}
   {:id :info-gain :levels [0 1] :score-varies? true
    :justification "action-dependent."}
   {:id :kl-risk :levels [0 1] :score-varies? true
    :justification "action-dependent; pilot showed ablating it nearly triples sparse starvation (0.233 -> 0.667) while raising yield."}]

  :arms
  [{:id :aif-full               :neutral? false :ablates []}
   {:id :no-canonical-ambiguity :neutral? false :ablates [:canonical-ambiguity]
    :role :positive-control}
   {:id :no-directed-eig        :neutral? false :ablates [:directed-eig]}
   {:id :no-info-gain           :neutral? false :ablates [:info-gain]}
   {:id :no-risk                :neutral? false :ablates [:kl-risk]}
   {:id :classic                :neutral? true  :ablates []
    :role :baseline
    :note "selection disabled; the empirical null the comparative claim obliges"}]

  :scenarios [:patchy :sparse :snowdrift]

  ;; Verbatim from the pilot so the runs are comparable.
  :environment {:size [10 10]
                :food {:patchy    {:num-patches 4 :patch-radius 2}
                       :sparse    {:num-patches 2 :patch-radius 1}
                       :snowdrift {:num-patches 4 :patch-radius 2}}
                :ticks 300 :initial-reserves 0.5 :metabolism 0.06
                :ants-per-side 3}

  ;; DISJOINT from the pilot, which used base 202608110/202608111/202658110.
  ;; Disjointness is a checkable property of these formulas, not a promise.
  :seeds {:runs-per-cell 30
          ;; Historical pilot formulas are data, not renderer folklore. They are
          ;; pinned by :clean/source/:pilot-sha above and provide the concrete
          ;; left side of ReplicationPlan.disjoint.
          :pilot {:runs-per-cell 30
                  :food-fn     "202608110 + 100000*s + 2*i"
                  :movement-fn "202608111 + 100000*s + 2*i"
                  :choice-fn   "202658110 + 100000*s + i"}
          :food-fn     "202609110 + 100000*s + 2*i"
          :movement-fn "202609111 + 100000*s + 2*i"
          :choice-fn   "202659110 + 100000*s + i"
          :disjoint-from-pilot? true}

  ;; EXTENSION 1 (claude-7, 2026-08-01): every endpoint declares the SENSOR that
  ;; supplies it and a COVERAGE PRECONDITION. Their V2 was salvage from receipt
  ;; fields populated at 16% with recency bias — a registration that does not
  ;; declare its sensor reproduces that failure inside this machinery. This is
  ;; DarkTower's check_sound discipline lifted to the endpoint level: an
  ;; endpoint whose sensor misses its coverage bar is NOT REPORTABLE, and the
  ;; render should refuse a primary endpoint with no sensor at all.
  :outcomes
  [{:id :yield :direction :higher-better :role :primary
    :sensor {:field :runs/yield
             :source "ants.aif.experiment run records"
             :coverage-precondition "every (scenario, arm, seed) cell present; 540 records"
             :coverage-check {:status :met :check :count-equals-design}}}
   {:id :starvation :direction :lower-better :role :primary
    :sensor {:field :runs/starved
             :source "ants.aif.experiment run records"
             :coverage-precondition "same 540 cells; starvation is share of yield exactly 0.0"
             :coverage-check {:status :met :check :count-equals-design}}
    :note "added on the pilot's evidence; yield alone cannot see a survival-trading controller"}
   {:id :selection-divergence :direction :informational :role :secondary
    :sensor {:field :runs/trajectory
             :source "per-tick action log"
             ;; reason vocabulary (claude-7): :sensor-absent / :coverage-below-threshold /
             ;; :regime-limited are different facts with different repairs. They hit
             ;; all three in one afternoon.
             :coverage-precondition "UNVERIFIED — the pilot did not persist trajectories"
             :coverage-check {:status :unmet :reason :sensor-absent
                              :repair "harness change: persist per-tick action log"}}
    :note "declared and NOT reportable under this registration: its sensor fails
           its own precondition. Recorded rather than dropped so the gap is
           visible; discharging it is a harness change, not an analysis choice."}]

  :stop-rules
  [{:id :positive-control-violated
    :fires-when "any paired (aif-full, no-canonical-ambiguity) run record differs"
    :comparison :full-run-record
    :note "record equality, NOT yield equality — the pilot's harness was strengthened to this mid-run and the weaker form is what codex-8 flagged"
    :action :abandon-run}]

  ;; EXTENSION 5 (claude-7's heads-up, 2026-08-01). Answer: the stop-rule and
  ;; decision-rule vocabulary does NOT cover an adaptive re-queue, and forcing it
  ;; there would hide the thing that matters.
  ;;
  ;;   :stop-rules  fire on the RUN and halt it.
  ;;   :decision    interprets a COMPLETED trace.
  ;;   :dispositions fire on a UNIT, mid-run, and change what it becomes.
  ;;
  ;; V3's cohort case: control-arm problems that fail one-shot are re-queued with
  ;; memory enabled — deferral rather than sacrifice, which is what makes the
  ;; control arm affordable. That is a post-primary disposition, and unregistered
  ;; it reads as contamination to any later auditor.
  ;;
  ;; THE FIELD THAT CARRIES THE INTEGRITY CONSTRAINT is :original-observation.
  ;; If a failed control observation is DROPPED when its unit is re-queued, the
  ;; control arm becomes silently conditioned on success and every contrast
  ;; against it is inflated. The re-queued run must be a NEW UNIT, not a
  ;; replacement. Registering the disposition without that field would document
  ;; the adaptivity and miss the hazard it creates.
  :dispositions []   ;; Slice 5 has none: every unit runs once, to completion,
                     ;; and no outcome changes what a unit is. Declared empty
                     ;; rather than omitted so the slot is visible and its
                     ;; absence is a statement.

  ;; Total: every trace the run can emit maps to a named outcome.
  :decision
  {:control-violated      :abandoned-analysis-invalid
   :no-arm-significant    :no-term-carries-effect
   :epistemic-significant :explore-exploit-regulator-established
   :risk-only-significant :risk-carries-effect-epistemic-decorative
   :mixed                 :report-per-scenario-no-global-claim
   :incomplete            :pilot-only-not-interpretable}

  ;; EXTENSION 2 (claude-7, 2026-08-01): what the design IDENTIFIES, with a
  ;; receipt reference — so "identified before spent" is a gate rather than a
  ;; habit. claude-7's sharpening applies here too: an ablation identifies the
  ;; effect of AVAILABILITY of a term, not of its content.
  ;; EXTENSION 3 (claude-7, 2026-08-01). Answer to the design question: YES,
  ;; holes are the right register — they are already "the things that can bite
  ;; you", and :clean/shape/:holes-at already tracks them. But :kind :gate is
  ;; the WRONG kind for what you describe.
  ;;
  ;;   :kind :gate       — UNDISCHARGED. Blocks a downstream box until it fires.
  ;;                       (e3's positive control: e4 may not run until it passes.)
  ;;   :kind :assumption — CURRENTLY DISCHARGED, CONDITIONALLY. Holds now, under
  ;;                       stated conditions, with a predicted expiry. It blocks
  ;;                       nothing today and invalidates results later.
  ;;
  ;; The second is genuinely different and stretching :gate to cover it would
  ;; lose the distinction that matters: one stops the run, the other dates it.
  ;; :breaks-when is REQUIRED on an :assumption — an assumption with no stated
  ;; way to fail is a belief.
  :assumptions
  [{:id :tau-argmax-invariance :kind :assumption
    :holds "argmax over -G/tau equals argmax over -G for every tau > 0, so the
            commitment temperature cannot affect selection"
    :holds-while "arithmetic is exact reals; ordering is total and tie-free"
    :breaks-when "IEEE double rounding creates ties, or underflow/overflow/NaN
                  appear in G or tau — none of which the exact-real argument
                  covers (codex-8, review of Slice5Preregistration.lean)"
    :evidence "90 bit-identical runs of arm :a3 in the authority pilot — evidence
               for the float case, NOT a proof of it"
    :on-break :invalidates-tau-claims-only
    :discharge-condition "a float-level argument, or a tie-detection assertion in
                          the selector that fails loudly rather than silently"}

   {:id :ablation-preserves-admissible-set :kind :assumption
    :holds "ablating a score term does not change which actions are admissible,
            so arms differ only in ordering within a fixed candidate set"
    :holds-while "the mode FSM and hard admissibility filters read observations
                  only, never scores"
    :breaks-when "any admissibility predicate comes to depend on a score term —
                  at which point ablation arms stop being comparable at all"
    :evidence "policy.clj: candidate filtering precedes scoring"
    :on-break :invalidates-all-contrasts
    :discharge-condition "a build-match relation asserting no admissibility
                          predicate reads a score field"}]

  :identification
  {:estimand "effect on (yield, starvation) of removing term T from the candidate
              score, holding environment, seeds and admissibility gating fixed"
   :identifies :availability-of-term
   :does-not-identify "the contribution of the quantity T is named after; a term
                       may be present, computed, and causally inert (proved for
                       :canonical-ambiguity)"
   :assumption "paired seeds make arms exchangeable; the mode FSM and admissible
                set are unaffected by ablation"
   :receipt-ref nil
   ;; {:none :requested :received :refused} (claude-7). :refused matters most:
   ;; a causal engine's TYPED REFUSAL, cited in a registration, is a stronger
   ;; artifact than an absent receipt — it records that identification was
   ;; sought and failed, rather than never attempted.
   :receipt-status :none
   :note "no external identification receipt exists for this design. Stated as
          absent rather than omitted. For V3's cohort and E2 the corresponding
          slot is expected to cite Rob's causal engine against
          futon3c/docs/memory-causal-graph-spec.json."}

  ;; EXTENSION 4 (claude-7, 2026-08-01): a hold-out names its ENFORCEMENT POINT.
  ;; Their near-miss: a hold-out norm written in mission prose while the dispatch
  ;; selector read only the queue — four held-out rows sat dispatchable. Rule
  ;; adopted: "hold-outs must be excluded in the selector, not the doc." An
  ;; enforcement that cannot be named is prose.
  ;;
  ;; Slice 5's hold-out is the pilot's seed universe, and it is a real one: the
  ;; confirmation must not reuse any seed the pilot has already shown us.
  :holdouts
  {:ids [:pilot-seed-universe]
   :enforced-by "the confirmation seed formulas themselves — distinct bases
                 (2026091xx vs 2026081xx) make reuse arithmetically impossible,
                 not merely unintended"
   :verified-by "computable disjointness over the generated universes: 270 pilot
                 seeds vs 270 confirmation seeds, overlap 0. Checked at
                 registration; the render should re-check at build."
   :note "the enforcement is in the generator, not in a review instruction —
          which is the whole content of this extension"}

  :budget {:estimated-cell-runs 540 :cap-cell-runs 720
           :teardown "artifacts written under futon2/holes/labs/ants-faithfulness/ regardless of outcome"}}

 ;; ---------------------------------------------------------------------------
 ;; Three readings of one object. This is the bridge.
 ;; ---------------------------------------------------------------------------
 :clean/copar [{:reading :informal   :is :clean/seq}
               {:reading :formal     :is [:clean/boxes :clean/wires]}
               {:reading :executable :is :clean/experiment-design
                :note "renders to a malli schema the harness must validate against before it starts; an unregistered arm is a startup failure, not a review finding"}]

 :clean/shape {:macro :controlled-ablation
               :holes-at [:e3]
               :assumptions-at [:tau-argmax-invariance
                                :ablation-preserves-admissible-set]
               :discharges-at [:e5]
               :note "the positive control is a hole in the INSTRUMENT, not in the hypothesis: e3 must discharge before e4 is permitted to run"}}
