{:given
 [{:var :C, :type :category}
  {:var :D, :type :category}
  {:var :F, :type :functor, :signature "F : C → D"}
  {:var :G, :type :functor, :signature "G : C → D"}],
 :name "natural transformation",
 :concept/id :natural-transformation,
 :msc "ct",
 :axioms
 [{:id :naturality,
   :statement
   "∀ f : a → b in C. G(f) ∘ α_a = α_b ∘ F(f)   (the naturality square commutes)",
   :refs [:composition :commutative-square]}],
 :holes [],
 :genus :morphism-of-functors,
 :status :golden,
 :kind :morphism,
 :provenance {:target "nlab-122", :source :curated},
 :depends-on
 [:functor :category :morphism :composition :commutative-square],
 :gloss
 {:text
  "A natural transformation α : F ⇒ G between functors F,G : C → D\n  assigns to each object a a morphism α_a : F a → G a such that for every\n  f : a → b the naturality square commutes."},
 :data
 [{:component :components,
   :signature "α_a : F a → G a in D   for each a ∈ Ob(C)"}]}
