    {
      "id": "disk-agreement",
      "kind": "premise",
      "claim": "For every ζ in the radius-r ball, eval ζ (apm_a96J06_poly N c) = eval ζ X.",
      "authority": "formal-proof",
      "evidence": [
        "lean:Main.lean#heval"
      ]
    },
    {
      "id": "infinite-sample-warrant",
      "kind": "warrant",
      "claim": "The points r/(n+2), n a natural number, are pairwise distinct and lie in the radius-r ball, so they form an infinite set; a set containing an infinite set is infinite.",
      "authority": "formal-proof",
      "evidence": [
        "lean:Main.lean#hset",
        "lean:Main.lean#huinj",
        "Mathlib:Set.infinite_range_of_injective",
        "Mathlib:Set.Infinite.mono"
      ]
    },
    {
      "id": "infinite-agreement",
      "kind": "claim",
      "claim": "The set of complex ζ at which apm_a96J06_poly N c and X have equal evaluations is infinite.",
      "authority": "formal-proof",
      "evidence": [
        "lean:Main.lean#hset"
      ]
    },
    {
      "id": "complex-domain",
      "kind": "premise",
      "claim": "ℂ is a commutative ring with no zero divisors, the instance hypotheses [CommRing R] [IsDomain R] of the Mathlib lemma.",
      "authority": "mathlib",
      "evidence": [
        "Mathlib.Algebra.Polynomial.Roots:variable [CommRing R] [IsDomain R]"
      ]
    },
    {
      "id": "polynomial-identity-warrant",
      "kind": "warrant",
      "claim": "Polynomial.eq_of_infinite_eval_eq: for R with [CommRing R] [IsDomain R], polynomials p q : R[X] are equal if {x | eval x p = eval x q} is infinite.",
      "authority": "mathlib",
      "evidence": [
        "Mathlib.Algebra.Polynomial.Roots:Polynomial.eq_of_infinite_eval_eq"
      ]
    },
    {
      "id": "polynomial-identity",
      "kind": "claim",
      "claim": "apm_a96J06_poly N c = Polynomial.X as polynomials over ℂ.",
