    {"id": "q", "kind": "question", "claim": "Where does the proof of part (a) use that H has finite index, and is the statement false without it?", "authority": "reader-question", "evidence": ["arse:ask-1795502266-360", "arse:ask-1795502265-357", "blueprint-alignment:b95J01:B2"]},
