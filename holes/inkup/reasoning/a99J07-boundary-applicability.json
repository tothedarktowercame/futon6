  "nodes": [
    {"id":"q","kind":"question","claim":"Why does the maximum-modulus step apply to the reflected polynomial at 1/w?","authority":"reader-question","evidence":["blueprint-alignment:a99J07:B6","candidate:se-math-4074935"]},
    {"id":"answer","kind":"answer","claim":"The formal lemma is specialized to polynomials and only consumes that its evaluation point is in the closed unit disk; reflection already produces a polynomial, and |w| > 1 puts 1/w in that disk.","authority":"secondary","evidence":["blueprint-alignment:a99J07:B4","blueprint-alignment:a99J07:B6","blueprint-alignment:a99J07:B7","lean:Main.lean#apm_a99J07_poly_le_boundary"]},
    {"id":"polynomial","kind":"premise","claim":"p.reflect N is a complex polynomial, hence its evaluation is continuous on the closed disk and differentiable on the open disk.","authority":"formal-proof","evidence":["blueprint-alignment:a99J07:B4","lean:Main.lean#apm_a99J07_poly_le_boundary"]},
    {"id":"inside-disk","kind":"premise","claim":"The point u = 1/w satisfies ‖u‖ ≤ 1.","authority":"formal-proof","evidence":["blueprint-alignment:a99J07:B7","lean:Main.lean#hu"]},
    {"id":"boundary-witness-warrant","kind":"warrant","claim":"apm_a99J07_poly_le_boundary uses compactness to choose a maximizer; if it is interior, Complex.norm_eqOn_closure_of_isPreconnected_of_isMaxOn makes the norm constant up to the boundary. It returns a boundary point v dominating the value at u.","authority":"formal-proof","evidence":["blueprint-alignment:a99J07:B6","lean:Main.lean#apm_a99J07_poly_le_boundary","Mathlib:Complex.norm_eqOn_closure_of_isPreconnected_of_isMaxOn"]},
    {"id":"boundary-witness","kind":"claim","claim":"There exists v with ‖v‖ = 1 and ‖(p.reflect N).eval u‖ ≤ ‖(p.reflect N).eval v‖.","authority":"formal-proof","evidence":["blueprint-alignment:a99J07:B6","lean:Main.lean#apm_a99J07_poly_le_boundary"]}
