{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futon.example/schema/inkup-presentation-plan-v0.json",
  "title": "InkUp presentation plan v0",
  "type": "object",
  "required": ["schema", "source", "scopes", "typed_node_accounting", "diagnostics"],
  "properties": {
    "schema": {"const": "inkup.presentation-plan/v0"},
    "source": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["human", "generated"]},
        "ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "array",
      "items": {"$ref": "#/$defs/scope"}
    },
    "typed_node_accounting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "action"],
        "properties": {
          "node": {"type": "string", "minLength": 1},
          "action": {"enum": ["show", "compress", "omit"]},
          "reason": {"type": "string"}
        },
        "allOf": [{
          "if": {"properties": {"action": {"enum": ["compress", "omit"]}}},
          "then": {"required": ["reason"], "properties": {"reason": {"minLength": 1}}}
        }],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "scope", "witnesses", "status"],
        "properties": {
          "kind": {"enum": ["example-scarcity", "sufficiency-wall", "unintroduced-dependency", "strategy-deficit", "administrative-dominance"]},
          "scope": {"type": "string"},
          "witnesses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "status": {"const": "report-only"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["id", "parent", "mining_layers", "roles", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent": {"type": ["string", "null"]},
        "mining_layers": {
          "type": "object",
          "description": "Observed Mark7 coverage, preserving C=S1, M=S3, Y=S4 rather than treating inks as rhetorical roles.",
          "required": ["C", "M", "Y"],
          "properties": {
            "C": {"type": "number", "minimum": 0, "maximum": 1},
            "M": {"type": "number", "minimum": 0, "maximum": 1},
            "Y": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "roles": {
          "type": "array",
          "items": {"enum": ["overview", "example", "reduction", "bridge", "calculation", "citation", "closure"]},
          "uniqueItems": true
        },
        "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
