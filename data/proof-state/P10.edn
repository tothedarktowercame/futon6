#:proof{:problem-id "P10", :version 4, :canonical {:statement "Given the mode-k subproblem [(Z⊗K_τ)ᵀD(Z⊗K_τ) + λ(I_r⊗K_τ)]vec(W) = (I_r⊗K_τ)vec(B), show that PCG solves this without O(N) computation.", :closure-criterion "All proof nodes verified or plausible, convergence assumptions explicit, gap ledger items closed or honestly partial", :statement-hash "sha256:1bbba9a6b364e50e1264702d35288b1b74c687dfe5dc4a18a0ebcd0e1d614877", :version-history [{:version 1, :statement "Given the mode-k subproblem [(Z⊗K_τ)ᵀD(Z⊗K_τ) + λ(I_r⊗K_τ)]vec(W) = (I_r⊗K_τ)vec(B), show that PCG solves this without O(N) computation.", :hash "sha256:1bbba9a6b364e50e1264702d35288b1b74c687dfe5dc4a18a0ebcd0e1d614877", :changed-at "2026-02-13T16:34:02.943540750Z", :reason "Initial statement"}]}, :ledger {"L-rhs" #:item{:id "L-rhs", :label "RHS formation in O(qr + n²r) via sparse MTTKRP", :status :proved, :depends-on #{}, :unlocks #{"L-problem"}, :artifact-paths ["data/first-proof/problem10-solution.md"], :evidence-type :analytical}, "L-verifier" #:item{:id "L-verifier", :label "Node-level verification: 15/15 parseable, 8 verified, 7 plausible", :status :proved, :depends-on #{}, :unlocks #{"L-problem"}, :artifact-paths ["data/first-proof/problem10-codex-results.jsonl" "data/first-proof/problem10-codex-prompts.jsonl"], :evidence-type :mixed}, "L-problem" #:item{:id "L-problem", :label "PCG solves RKHS-CP without O(N): convergence gap resolved via improved preconditioner", :status :partial, :depends-on #{"L-rhs" "L-verifier" "L-complexity" "L-discipline" "L-spd" "L-algorithm"}, :unlocks #{}, :artifact-paths ["data/first-proof/problem10-solution.md" "data/first-proof/problem10-writeup.md" "data/first-proof/problem10-wiring.json" "data/first-proof/problem10-improved-precond-results.json"], :evidence-type :mixed}, "L-matvec" #:item{:id "L-matvec", :label "Implicit matvec in O(n²r + qr): forward + adjoint + regularization", :status :proved, :depends-on #{}, :unlocks #{"L-complexity"}, :artifact-paths ["data/first-proof/problem10-solution.md" "data/first-proof/problem10-codex-results.jsonl"], :evidence-type :analytical}, "L-complexity" #:item{:id "L-complexity", :label "Total O(n³ + t(n²r + qr)), no N-dependence", :status :proved, :depends-on #{"L-matvec" "L-precond" "L-convergence"}, :unlocks #{"L-problem"}, :artifact-paths ["data/first-proof/problem10-solution.md"], :evidence-type :analytical}, "L-precond" #:item{:id "L-precond", :label "Improved Kronecker preconditioner P_new = c(G⊗K_τ²) + λ(I_r⊗K_τ)", :status :proved, :depends-on #{}, :unlocks #{"L-complexity" "L-convergence"}, :artifact-paths ["data/first-proof/problem10-solution.md" "data/first-proof/problem10-codex-results.jsonl" "scripts/verify-p10-improved-preconditioner.py" "data/first-proof/problem10-improved-precond-results.json"], :evidence-type :analytical}, "L-discipline" #:item{:id "L-discipline", :label "Gap ledger + cycle record present in solution", :status :proved, :depends-on #{}, :unlocks #{"L-problem"}, :artifact-paths ["data/first-proof/problem10-solution.md"], :evidence-type :analytical}, "L-convergence" #:item{:id "L-convergence", :label "PCG converges fast with improved preconditioner: δ < 1 under uniform sampling", :status :numerically-verified, :depends-on #{"L-precond"}, :unlocks #{"L-complexity"}, :artifact-paths ["data/first-proof/problem10-solution.md" "scripts/verify-p10-convergence-gap.py" "data/first-proof/problem10-convergence-gap-results.json" "scripts/verify-p10-improved-preconditioner.py" "data/first-proof/problem10-improved-precond-results.json"], :evidence-type :mixed, :failure-point "RESOLVED: δ < 1 achieved with P_new = c(G⊗K_τ²) + λ(I_r⊗K_τ) under uniform sampling (mean δ = 0.89, 18/22 configs). Original P=H⊗K_τ had K_τ where A has K_τ², giving built-in mismatch. Adversarial sampling caveat remains (δ ∈ [1.4, 2.5])."}, "L-spd" #:item{:id "L-spd", :label "System A_τ is SPD under λ>0, K_τ≻0 (CG applicable)", :status :proved, :depends-on #{}, :unlocks #{"L-problem"}, :artifact-paths ["data/first-proof/problem10-solution.md" "data/first-proof/problem10-codex-results.jsonl"], :evidence-type :analytical}, "L-algorithm" #:item{:id "L-algorithm", :label "Pseudocode: SETUP + PCG + MATVEC + PRECOND_SOLVE", :status :proved, :depends-on #{}, :unlocks #{"L-problem"}, :artifact-paths ["data/first-proof/problem10-solution.md"], :evidence-type :analytical}}, :cycles [#:cycle{:id "P10-C001", :blocker-id "L-convergence", :phase :commit, :phases-completed [:observe :propose :execute :validate :classify :integrate], :phase-data {:observe {:blocker-id "L-convergence"}, :propose {:approach "CONVERGENCE GAP ANALYSIS (SR-4 counterexample-first):\n  1. Construct small RKHS-constrained tensor CP problems\n  2. Measure spectral-equivalence δ for P^{-1/2}A P^{-1/2}\n  3. Test uniform vs adversarial sampling patterns\n  4. Test high-coherence vs standard factor matrices\n  5. Test λ sensitivity (small λ → poor conditioning?)\n  6. Run PCG and verify convergence rate\n  7. Compare empirical δ against the claim δ < 1\n\nHypothesis: δ < 1 spectral equivalence does NOT hold\nwith the stated Kronecker preconditioner for arbitrary\nsampling patterns, implying the O(log(1/ε)) convergence\nclaim needs explicit sampling assumptions."}, :execute {:artifacts ["scripts/verify-p10-convergence-gap.py" "data/first-proof/problem10-convergence-gap-results.json"]}, :validate {:validation-artifacts ["data/first-proof/problem10-convergence-gap-results.json"]}, :classify {:classification {:status :partial, :evidence-type :mixed, :finding "P10-G2 GAP CONFIRMED: empirical δ ranges from 5.2 to 22.7, far above the required δ < 1 for spectral equivalence. The Kronecker preconditioner P = H⊗K_τ is NOT spectrally equivalent to A in the strong sense. PCG converges but at rate O(√κ·log(1/ε)) with κ = 10-575, not O(log(1/ε)). The N-independence result holds; convergence rate does not."}}, :integrate {:rationale "P10-G2 convergence gap analysis complete. Gap confirmed: δ >> 1 empirically, spectral equivalence does NOT hold as stated. L-convergence remains :partial with updated evidence. Failed route recorded for the strong spectral-equivalence claim. Main N-independence result unaffected.", :ledger-changes {"L-convergence" "added 2 artifact paths (script + results JSON)"}}}, :started-at "2026-02-13T16:34:03.115441467Z", :updated-at "2026-02-13T16:34:04.190616115Z"} #:cycle{:id "P10-C002", :blocker-id "L-convergence", :phase :integrate, :phases-completed [:observe :propose :execute :validate :classify], :phase-data {:observe {:blocker-id "L-convergence"}, :propose {:approach "IMPROVED PRECONDITIONER (root cause fix):\n\nROOT CAUSE: Original P = H⊗K_τ has K_τ where A has K_τ².\nEven when D = cI exactly, mismatch A-P = c·Z^TZ⊗K_τ(K_τ-I).\n\nFIX: P_new = c(G⊗K_τ²) + λ(I_r⊗K_τ)\nwhere G = (1/q)Z^TZ is the Gram matrix of sampling.\n\nProperties:\n  1. P_new exactly matches A when D = cI (δ = 0)\n  2. Efficiently invertible via eigendecomposition of K_τ:\n     K_τ = UΛU^T → P_new block-diagonalizes to n blocks of r×r\n     B_i = cμ_i²·G + λμ_i·I_r, cost O(n²r + nr²)\n  3. Same asymptotic cost as original preconditioner\n\nHypothesis: P_new achieves δ < 1 under uniform sampling,\nrestoring the O(log(1/ε)) convergence claim.\nAdversarial sampling may still require explicit assumptions."}, :execute {:artifacts ["scripts/verify-p10-improved-preconditioner.py" "data/first-proof/problem10-improved-precond-results.json"]}, :validate {:validation-artifacts ["data/first-proof/problem10-improved-precond-results.json"]}, :classify {:classification {:status :numerically-verified, :evidence-type :mixed, :finding "P10-G2 RESOLVED via improved preconditioner. Root cause: original P=H⊗K_τ has K_τ where A has K_τ², giving mismatch c·Z^TZ⊗K_τ(K_τ-I) even for D=cI. Fix: P_new = c(G⊗K_τ²) + λ(I_r⊗K_τ). Results: δ_new < 1 for 18/22 configs, consistently < 1 under uniform sampling (mean 0.89 vs old 11.07). Exact match when D=cI (δ=1.4e-13). Efficiently invertible via K_τ eigendecomposition at O(n²r+nr²). Adversarial sampling still gives δ > 1 (1.4-2.5). Convergence claim O(log(1/ε)) justified with P_new under uniform sampling."}}}, :started-at "2026-02-13T16:35:14.062436587Z", :updated-at "2026-02-13T16:35:14.961023187Z"}], :failed-routes [#:route{:id "FR-2304f5d2-abb7-42fa-af4c-12afa780cdf6", :recorded-at "2026-02-13T16:34:03.012714403Z", :blocker-id "L-verifier", :approach "Codex o3 model node verification (15 prompts)", :failure-reason "Model mismatch: o3 not supported with ChatGPT account; all 15 nodes returned parse_error", :evidence-refs ["data/first-proof/problem10-codex-results.jsonl"]} #:route{:id "FR-426c6855-26da-43bf-8763-7616493a56a2", :recorded-at "2026-02-13T16:34:04.184773578Z", :blocker-id "L-convergence", :approach "Spectral equivalence (1-δ)P ≤ A ≤ (1+δ)P with δ < 1", :failure-reason "Empirical falsification: δ ranges 5.2-22.7 across uniform/adversarial sampling (n=4-10, r=2, q/N=0.1-0.9). Adversarial row-concentrated sampling gives κ up to 575. High coherence worsens δ (18.1 vs 12.1). Small λ causes κ blowup. The Kronecker preconditioner replaces D with cI but this introduces error larger than λ_min(P).", :evidence-refs ["scripts/verify-p10-convergence-gap.py" "data/first-proof/problem10-convergence-gap-results.json"]}], :updated-at "2026-02-13T16:35:15.002369986Z"}