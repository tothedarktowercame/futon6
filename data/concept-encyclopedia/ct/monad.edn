{:given [{:var :C, :type :category}],
 :name "monad",
 :concept/id :monad,
 :msc "ct",
 :axioms
 [{:id :associativity,
   :statement
   "μ ∘ (T μ) = μ ∘ (μ T)   as natural transformations T³ ⇒ T",
   :refs [:natural-transformation]}
  {:id :left-unit,
   :statement "μ ∘ (η T) = id_T",
   :refs [:identity-morphism]}
  {:id :right-unit,
   :statement "μ ∘ (T η) = id_T",
   :refs [:identity-morphism]}],
 :holes [],
 :genus :monoid-in-endofunctors,
 :status :golden,
 :kind :object,
 :provenance {:target "nlab-255", :source :curated},
 :depends-on
 [:category
  :endofunctor
  :natural-transformation
  :identity-functor
  :composition],
 :gloss
 {:text
  "A monad on C is an endofunctor T : C → C with natural transformations\n  μ : T² ⇒ T and η : Id_C ⇒ T satisfying associativity (μ∘Tμ = μ∘μT) and the unit\n  laws (μ∘ηT = μ∘Tη = id_T) — a monoid in the endofunctor category."},
 :data
 [{:component :endofunctor, :signature "T : C → C"}
  {:component :multiplication,
   :signature "μ : T ∘ T ⇒ T   (natural transformation)"}
  {:component :unit,
   :signature "η : Id_C ⇒ T   (natural transformation)"}]}
