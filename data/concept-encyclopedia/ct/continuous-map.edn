{:concept/id :continuous-map :name "continuous map" :msc "ct" :kind :morphism :df 426 :pagerank nil :used-papers nil :depends-on [:least-element :finite-meets :greatest-element] :gloss {:paper "0711.4401" :text "mph{homomorphism} of locales $h:X\\to Y$ is a function that preserves arbitrary joins (including the least element $0$) and finite meets (including the greatest element $1$); and a \\emph{continuous map} of locales (or simply a \\emph{map}) $f:Y\\to X$ is a homomorphism in the opposite direction, $f^*:X"} :components {:genus :function :differentiae []} :defined-in {:n-papers 27 :sample ["0709.4364" "0711.4401" "0912.1415" "1009.3553" "1102.1313"]} :provenance {:target "nlab-2120" :resolution-kind "definition-site"} :holes [{:kind :hole :type :formalise-structure :wanted "render differentiae as typed forall/exists conditions (APM-Xi item form)"}]}
