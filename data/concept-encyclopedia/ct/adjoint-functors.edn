{:concept/id :adjoint-functors :name "adjoint functors" :msc "ct" :kind :morphism :df 649 :pagerank nil :used-papers nil :depends-on [] :gloss {:paper "0704.2207" :text "s. Let $\\mathbf{X}$ and $\\mathbf{A}$ be categories and $F:\\mathbf{X\\rightarrow A}$ and $G:\\mathbf{A\\rightarrow X}$ functors between them. Then $F$ and $G$ are said to be a pair of \\textit{adjoint functors} or an \\textit{adjunction}, written $F\\dashv G$, if for any $x$ in $\\mathbf{X}$ and $a$ in $\\ma"} :components {:genus nil :differentiae [{:clause "for any $x$ in $\\mathbf{X}$ and $a$ in $\\ma" :refs [:mathbf]}]} :defined-in {:n-papers 30 :sample ["0704.2207" "0804.1460" "0810.2070" "0811.4304" "0909.3162"]} :provenance {:target "nlab-494" :resolution-kind "definition-site"} :holes [{:kind :hole :type :formalise-structure :wanted "render differentiae as typed forall/exists conditions (APM-Xi item form)"}]}
