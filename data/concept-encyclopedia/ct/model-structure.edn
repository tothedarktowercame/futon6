{:concept/id :model-structure :name "model structure" :msc "ct" :kind :object :df 742 :pagerank 0.002249 :used-papers 430 :depends-on [:cocomplete-category] :gloss {:paper "0910.2733" :text "Indeed, a particularly concise definition of a model structure on a complete and cocomplete category $\\M$ is the following: a \\emph{model structure} consists of three class of maps $\\C$, $\\F$, $\\W$ such that $\\W$ satisfies the 2-of-3 property and such that $(\\C \\cap \\W, \\F)$ and $(\\C, \\W \\cap \\F)$ are wfs.\\footnote{It is not i"} :components {:genus nil :differentiae [{:clause "$\\W$ satisfies the 2-of-3 property and such that $(\\C \\cap \\W, \\F)$ and $(\\C, \\W \\cap \\F)$ are wfs.\\footnote{It is not i" :refs [:property :footnote :satisfies]}]} :defined-in {:n-papers 78 :sample ["0801.0404" "0906.4087" "0910.2733" "1104.1805" "1109.2883"]} :provenance {} :holes [{:kind :hole :type :formalise-structure :wanted "render differentiae as typed forall/exists conditions (APM-Xi item form)"}]}
