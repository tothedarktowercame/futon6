{:given
 [{:var :C, :type :category}
  {:var :D, :type :category}
  {:var :F, :type :functor, :signature "F : C → D   (left adjoint)"}
  {:var :G, :type :functor, :signature "G : D → C   (right adjoint)"}],
 :name "adjoint functor",
 :df 588,
 :concept/id :adjoint-functor,
 :msc "ct",
 :defined-in {:n-papers 2, :sample ["0706.0711" "2407.03488"]},
 :axioms
 [{:id :naturality,
   :statement
   "φ is natural in a and in b: ∀ h : a' → a in C, k : b → b' in D. the square relating φ_{a,b}, φ_{a',b'} under pre/post-composition commutes",
   :refs [:natural-transformation :composition]}],
 :holes [],
 :genus :adjunction,
 :status :formalized,
 :kind :property,
 :provenance
 {:target "nlab-494",
  :resolution-kind "definition-site",
  :formaliser :codex-1-redo,
  :formaliser-note
  "derived from ct-golden adjunction seed for adjunction-variant entry",
  :definition-source :nlab-dictionary-definition,
  :nlab-page-id "494",
  :definition-id "nlab-494-d1"},
 :depends-on
 [:adjunction
  :functor
  :natural-transformation
  :natural-isomorphism
  :hom-set],
 :equivalent-to
 [{:form :unit-counit,
   :data ["η : Id_C ⇒ G F (unit)" "ε : F G ⇒ Id_D (counit)"],
   :axioms
   ["(εF) ∘ (Fη) = id_F" "(Gε) ∘ (ηG) = id_G   (triangle identities)"],
   :refs [:natural-transformation :identity-morphism]}],
 :gloss
 {:text
  "adjoint functor is represented here by the adjunction structure: F is left adjoint to G (F ⊣ G) when there is a natural isomorphism\n  D(F a, b) ≅ C(a, G b) for all a ∈ C, b ∈ D; equivalently, unit/counit natural\n  transformations satisfying the triangle identities."},
 :data
 [{:component :hom-isomorphism,
   :signature
   "φ_{a,b} : D(F a, b) ≅ C(a, G b)   for a ∈ Ob(C), b ∈ Ob(D)"}]}
