;; The Argument as a mission wiring diagram.
;;
;; This is the first futon project that starts with a wiring diagram at the
;; core. Part IV described a real-time argumentation capture system as
;; aspirational — "the distance is a tooling gap, not a conceptual one."
;; This mission diagram closes that gap by specifying the system architecture
;; in a format that futon5.ct.mission/validate can check.
;;
;; The diagram encodes two nested AIF loops:
;;   Level 0 (fast):    Commit ingestion → AIF typing → stationarity detection → interrupt
;;   Level 1 (slow):    Evidence accumulation → pattern extraction → query interface
;;
;; Three infrastructure pieces from the futon stack provide the substrate:
;;   futon5 (Arxana)   — typed-edge graph store (I0 in the-argument-wiring.json)
;;   futon3c (gauntlet) — peripheral model for reflect hops (I1)
;;   futon6 (P0 tagger) — pattern recognition from commit traces (existing code)
;;
;; The (layer, status) monitor (I2) is the NEW component this mission builds.
;;
;; Validated by: (futon5.ct.mission/validate (edn/read-string (slurp "this-file")))

{:mission/id :the-argument-live
 :mission/state :scoped

 ;; ============================================================
 ;; INPUTS — what enters the system from outside
 ;; ============================================================
 :ports
 {:input
  [;; Commit stream — the raw trace data (fastest timescale)
   ;; This is G0 in the argument: "Raw data / Git hashes and commit traces"
   {:id :I-commits
    :name "Git commit stream"
    :type :git-trace
    :source "git hooks / CI pipeline / agent session logs"
    :timescale :fast}

   ;; Proof state — current status of each problem (medium timescale)
   ;; This is the *-wiring.json and proof-state/*.edn files
   {:id :I-proof-state
    :name "Proof state ledgers"
    :type :edn-document
    :source "data/proof-state/*.edn + data/first-proof/*-wiring.json"
    :timescale :medium}

   ;; Design patterns — what constitutes good strategy (CONSTRAINT)
   ;; This is the pattern library: slow, not writable by fast dynamics.
   ;; From the argument: "five design patterns with evidence ledgers"
   {:id :I-patterns
    :name "Strategy pattern library"
    :type :pattern-catalog
    :source "futon3/library/**/*.flexiarg + Part IV evidence ledgers"
    :timescale :slow
    :constraint true}

   ;; Human coaching — exogenous preferences (CONSTRAINT)
   ;; From the argument: "Coach, don't dispatch" — the coaching questions
   ;; that triggered P6's layer switch are the paradigmatic example.
   {:id :I-coaching
    :name "Human coaching prompts"
    :type :preference
    :source "human"
    :timescale :glacial
    :constraint true}

   ;; AIF type system — what node/edge types exist (CONSTRAINT)
   ;; From the argument: "claim / conflict / preference / inference"
   ;; This is the ontology, not the data — glacial, not writable.
   {:id :I-aif-types
    :name "AIF type ontology"
    :type :config
    :source "futon5/docs/chapter0-aif-as-wiring-diagram.md"
    :timescale :glacial
    :constraint true}]

  ;; ============================================================
  ;; OUTPUTS — what the system produces
  ;; ============================================================
  :output
  [;; Live AIF graph — the target system (T1 in the argument)
   ;; "Live AIF graph; patterns become graph queries"
   {:id :O-aif-graph
    :name "Live AIF argument graph"
    :type :xtdb-entity
    :consumer "Arxana (futon5) / graph queries / visualization"
    :spec-ref "the-argument-wiring.json:arg-T1"
    :timescale :medium}

   ;; Metacognitive interrupts — policy-switch triggers
   ;; "Trigger policy switch on stationarity/falsification"
   {:id :O-interrupts
    :name "Metacognitive interrupt signals"
    :type :action-stream
    :consumer "agent session / peripheral scheduler"
    :spec-ref "the-argument-wiring.json:arg-X2"
    :timescale :fast}

   ;; Pattern query results — strategy analogy lookups
   ;; "Cross-problem learning: strategy-level analogy"
   {:id :O-queries
    :name "Strategy analogy query results"
    :type :edn-document
    :consumer "stuck agent / coaching system"
    :spec-ref "the-argument-wiring.json:arg-X0"
    :timescale :medium}

   ;; Evidence records — PARs from reflect hops
   {:id :O-evidence
    :name "Reflect-hop evidence"
    :type :par-record
    :consumer "evidence graph / proof state"
    :spec-ref "the-argument-wiring.json:arg-S3"
    :timescale :medium}

   ;; Status events — telemetry from the monitor
   {:id :O-events
    :name "Monitor events"
    :type :xtdb-entity
    :consumer "dashboard / logging"
    :spec-ref "the-argument-wiring.json:arg-I2"
    :timescale :fast}]}

 ;; ============================================================
 ;; COMPONENTS — the system's processing stages
 ;; ============================================================
 :components
 [;; C-ingest: Commit trace → AIF node typing
  ;; This is G0→G1 in the argument: raw data → evidence ledgers.
  ;; Existing code: scripts/tag-patterns.bb does classical hotword
  ;; matching (P0); this extends it to commit-level AIF typing.
  {:id :C-ingest
   :name "Commit AIF classifier"
   :type :clj-namespace
   :ref "futon6/scripts/tag-patterns.bb"
   :accepts #{:git-trace :config :pattern-catalog}
   :produces #{:xtdb-entity}
   :timescale :fast}

  ;; C-monitor: (layer, status) stationarity detector
  ;; This is I2 in the argument — THE NEW COMPONENT.
  ;; "Track (layer, status) pairs across commits; flag stationarity
  ;; after k cycles." Reads the typed commit stream, detects when
  ;; the same (layer, status) pair repeats without progress.
  {:id :C-monitor
   :name "Stationarity monitor"
   :type :clj-namespace
   :ref "NEW — to be built"
   :accepts #{:xtdb-entity :edn-document}
   :produces #{:xtdb-entity :action-stream}
   :timescale :fast}

  ;; C-interrupt: Metacognitive interrupt generator
  ;; This is X2 in the argument. When the monitor detects
  ;; stationarity or falsification, this component generates
  ;; the coaching prompt that triggers a reflect hop.
  ;; "What kind of problem is this? Who would find it easy?"
  {:id :C-interrupt
   :name "Interrupt generator"
   :type :clj-namespace
   :ref "NEW — to be built (uses I-coaching templates)"
   :accepts #{:action-stream :preference :pattern-catalog}
   :produces #{:action-stream :par-record}
   :timescale :fast}

  ;; C-graph: Arxana AIF graph store
  ;; This is I0 in the argument. Uses futon5's typed-edge graph
  ;; substrate. Stores AIF nodes and edges persistently.
  ;; "Arxana provides the typed-edge graph substrate."
  {:id :C-graph
   :name "Arxana AIF store"
   :type :clj-namespace
   :ref "futon5/src/futon5/ct/mission.clj"
   :accepts #{:xtdb-entity :config}
   :produces #{:xtdb-entity}
   :timescale :medium}

  ;; C-reflect: Peripheral reflect-hop scheduler
  ;; This is I1 in the argument. Uses futon3c's gauntlet wiring
  ;; to schedule reflect hops that produce argumentative annotation.
  ;; "The constraint is what makes reflection generative."
  {:id :C-reflect
   :name "Reflect-hop scheduler"
   :type :clj-namespace
   :ref "futon3c/holes/missions/gauntlet-wiring.edn"
   :accepts #{:action-stream :xtdb-entity :edn-document}
   :produces #{:par-record :xtdb-entity}
   :timescale :fast}

  ;; C-query: Strategy analogy search
  ;; This is X0→X1 in the argument. Given a stuck problem,
  ;; find problems with similar obstruction profiles that closed.
  ;; "Strategy-level analogy: the transfer operates at the level
  ;; of proof strategy, not mathematical content."
  {:id :C-query
   :name "Strategy analogy engine"
   :type :clj-namespace
   :ref "futon3a (compass / notions search)"
   :accepts #{:edn-document :xtdb-entity :pattern-catalog}
   :produces #{:edn-document}
   :timescale :medium}

  ;; C-default: Stall detection (I6 compositional closure)
  ;; If the interrupt pipeline stalls, this keeps monitoring alive.
  ;; Analogous to C-tickle in the gauntlet wiring.
  {:id :C-default
   :name "Stall watchdog"
   :type :clj-namespace
   :ref "chapter0/default-mode-network"
   :accepts #{:xtdb-entity :edn-document}
   :produces #{:action-stream :xtdb-entity}
   :timescale :fast}]

 ;; ============================================================
 ;; EDGES — typed wires connecting the diagram
 ;; ============================================================
 :edges
 [;; === LEVEL 0: COMMIT → MONITOR → INTERRUPT (fast loop) ===

  ;; Commits enter the classifier
  {:from :I-commits     :to :C-ingest    :type :git-trace}

  ;; AIF types constrain classification
  {:from :I-aif-types   :to :C-ingest    :type :config}

  ;; Patterns guide classification
  {:from :I-patterns    :to :C-ingest    :type :pattern-catalog}

  ;; Classified commits → graph store
  {:from :C-ingest      :to :C-graph     :type :xtdb-entity}

  ;; Classified commits → monitor
  {:from :C-ingest      :to :C-monitor   :type :xtdb-entity}

  ;; Proof state feeds monitor (what's open, what's closed)
  {:from :I-proof-state :to :C-monitor   :type :edn-document}

  ;; Monitor detects stationarity → interrupt
  {:from :C-monitor     :to :C-interrupt :type :action-stream}

  ;; Coaching prompts constrain interrupts (I4: exogenous)
  {:from :I-coaching    :to :C-interrupt :type :preference}

  ;; Patterns inform interrupt framing
  {:from :I-patterns    :to :C-interrupt :type :pattern-catalog}

  ;; Interrupt → reflect-hop scheduler
  {:from :C-interrupt   :to :C-reflect   :type :action-stream}

  ;; Reflect hop reads graph state (what AIF nodes exist)
  {:from :C-graph       :to :C-reflect   :type :xtdb-entity}

  ;; Reflect hop reads proof state
  {:from :I-proof-state :to :C-reflect   :type :edn-document}

  ;; Reflect hop produces evidence (PAR) → graph store
  {:from :C-reflect     :to :C-graph     :type :xtdb-entity}

  ;; === LEVEL 1: QUERY INTERFACE (medium/slow loop) ===

  ;; Graph → query engine (what patterns are in the graph)
  {:from :C-graph       :to :C-query     :type :xtdb-entity}

  ;; Proof state → query engine (current status)
  {:from :I-proof-state :to :C-query     :type :edn-document}

  ;; Patterns → query engine (analogy index)
  {:from :I-patterns    :to :C-query     :type :pattern-catalog}

  ;; AIF types constrain graph store
  {:from :I-aif-types   :to :C-graph     :type :config}

  ;; === OUTPUTS ===

  ;; Graph store → live AIF graph output
  {:from :C-graph       :to :O-aif-graph  :type :xtdb-entity}

  ;; Interrupt → output
  {:from :C-interrupt   :to :O-interrupts :type :action-stream}

  ;; Query engine → query results output
  {:from :C-query       :to :O-queries    :type :edn-document}

  ;; Reflect hop → evidence output
  {:from :C-reflect     :to :O-evidence   :type :par-record}

  ;; Monitor → events output
  {:from :C-monitor     :to :O-events     :type :xtdb-entity}

  ;; === DEFAULT MODE (I6: compositional closure) ===

  ;; Stall watchdog reads graph and proof state
  {:from :C-graph       :to :C-default   :type :xtdb-entity}
  {:from :I-proof-state :to :C-default   :type :edn-document}

  ;; If main pipeline stalls, watchdog generates fallback interrupt
  {:from :C-default     :to :O-interrupts :type :action-stream}
  {:from :C-default     :to :O-events     :type :xtdb-entity}]}
